# ====================================================================
# EduSync Environment Variables Template
# Copy this file to .env and configure your keys
# ====================================================================

# 1. Supabase Client Configuration (Public / Mobile App)
# Public keys used directly in the Flutter mobile application
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# 2. Supabase Server-Side Environment Variables (Edge Function Secrets)
# These keys are set strictly on the Supabase backend via Edge Function Secrets:
# supabase secrets set AI_API_KEY=... SUPABASE_SERVICE_ROLE_KEY=...
# NEVER place AI_API_KEY or SUPABASE_SERVICE_ROLE_KEY in the mobile app bundle!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
AI_PROVIDER=gemini # Supported options: gemini, openai, groq, anthropic
AI_API_KEY=your-ai-api-key
AI_MODEL=gemini-1.5-flash # e.g. gemini-1.5-flash, gemini-1.5-pro, gpt-4o-mini

# 3. Application Metadata
PACKAGE_NAME=com.edusync.app
APP_VERSION=1.1.0
BUILD_NUMBER=2
